# Keep the driver and its compiler/assembler in the repository's Hermit toolchain.
go := justfile_directory() / "../../bin/go"
default_os := shell('"$1" env GOHOSTOS', go)
default_arch := shell('"$1" env GOHOSTARCH', go)

# Build natively with system libusb development files and a C compiler
build os=default_os arch=default_arch:
    @if [ "{{ os }}" != "{{ default_os }}" ] || [ "{{ arch }}" != "{{ default_arch }}" ]; then echo "cb_st_flasher requires a native {{ os }}/{{ arch }} host with libusb development files and a C compiler; this host is {{ default_os }}/{{ default_arch }}." >&2; exit 1; fi
    @pkg-config --exists libusb-1.0 || { echo "cb_st_flasher requires pkg-config and the system libusb-1.0 development package." >&2; exit 1; }
    @mkdir -p dist/{{ os }}-{{ arch }}
    CGO_ENABLED=1 GOOS={{ os }} GOARCH={{ arch }} "{{ go }}" build \
        -o dist/{{ os }}-{{ arch }}/cb_st_flasher ./cmd/cb_st_flasher
    @echo "Built: dist/{{ os }}-{{ arch }}/cb_st_flasher"

# Clean build artifacts
clean:
    @rm -rf dist/
    @"{{ go }}" clean

# Run from invocation directory
run *ARGS:
    @cd "{{ invocation_directory() }}" && CGO_ENABLED=1 "{{ go }}" run "{{ justfile_directory() }}/cmd/cb_st_flasher" {{ ARGS }}
