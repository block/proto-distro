From 472c8977e0238e5a1ed4d29d7c41de699646ceff Mon Sep 17 00:00:00 2001
From: Richard Purdie <richard.purdie@linuxfoundation.org>
Date: Mon, 12 Jan 2026 22:10:32 +0000
Subject: [PATCH] ports/linux/pseudo_wrappers: Avoid openat2 usage via syscall

There is a CVE patch (CVE-2025-45582) to tar 1.34 in Centos Stream which
uses syscall to access openat2() and breaks builds if we don't redirect using
a NOSYS error code.

As per the other entries here, there is also concern about trying
to parse syscall arguments in this function too.

We still need to add a wrapper for openat2 itself which is in the new
upcoming glibc release.

Ubuntu 22.04 also backported this tar change. Backport includes a local
regression test for the tar copy used by do_package, including ownership,
permissions and symlinks.

Upstream-Status: Backport [https://git.yoctoproject.org/pseudo/commit/?id=472c8977e0238e5a1ed4d29d7c41de699646ceff]
Signed-off-by: Richard Purdie <richard.purdie@linuxfoundation.org>
---
 ports/linux/pseudo_wrappers.c | 13 +++++++++++++
 test/test-tar-copy.sh         | 22 ++++++++++++++++++++++
 2 files changed, 35 insertions(+)

diff --git a/ports/linux/pseudo_wrappers.c b/ports/linux/pseudo_wrappers.c
index c39cf20..6b54083 100644
--- a/ports/linux/pseudo_wrappers.c
+++ b/ports/linux/pseudo_wrappers.c
@@ -92,6 +92,19 @@ syscall(long number, ...) {
 	}
 #endif
 
+#ifdef SYS_openat2
+	/* concerns exist about trying to parse arguments because syscall(2)
+	 * specifies strange ABI behaviors. If we can get better clarity on
+	 * that, it could make sense to redirect to wrap_openat2().
+	 * There is a CVE patch (CVE-2025-45582) to tar 1.34 in Centos Stream which
+	 * uses syscall to access openat2() and breaks builds if we don't redirect.
+	 */
+	if (number == SYS_openat2) {
+		errno = ENOSYS;
+		return -1;
+	}
+#endif
+
 	/* gcc magic to attempt to just pass these args to syscall. we have to
 	 * guess about the number of args; the docs discuss calling conventions
 	 * up to 7, so let's try that?
diff --git a/test/test-tar-copy.sh b/test/test-tar-copy.sh
new file mode 100755
--- /dev/null
+++ b/test/test-tar-copy.sh
@@ -0,0 +1,22 @@
+#!/bin/bash
+# SPDX-License-Identifier: LGPL-2.1-only
+set -euo pipefail
+
+# Host tar may use openat2 after CVE-2025-45582 security updates.
+work=$(mktemp -d "$PWD/test-tar-copy.XXXXXX")
+trap 'rm -rf "$work"' EXIT
+
+mkdir -p "$work/image/usr/lib" "$work/package"
+printf 'package payload\n' > "$work/image/usr/lib/sample"
+chown 123:456 "$work/image/usr/lib/sample"
+chmod 4755 "$work/image/usr/lib/sample"
+ln -s lib/sample "$work/image/usr/sample"
+
+tar --exclude=./sysroot-only -cf - -C "$work/image" -p -S . |
+    tar -xf - -C "$work/package"
+
+cmp "$work/image/usr/lib/sample" "$work/package/usr/lib/sample"
+test "$(stat -c '%u:%g:%a' "$work/package/usr/lib/sample")" = 123:456:4755
+test "$(readlink "$work/package/usr/sample")" = lib/sample
+
+exit 0
-- 
2.39.5
