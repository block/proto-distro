/dts-v1/;

#include "stm32mp157.dtsi"
#include "stm32mp15xd.dtsi"
#include "stm32mp15-pinctrl.dtsi"
#include "stm32mp15xxac-pinctrl.dtsi"
#include "stm32mp15xx-dkx.dtsi"

/ {
	model = "STMicroelectronics STM32MP157D-DK1 Discovery Board";
	compatible = "st,stm32mp157d-dk1", "st,stm32mp157";

	aliases {
		ethernet0 = &ethernet0;
		i2c1 = &i2c1;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	fan0: pwm-fan0 {
		compatible = "pwm-fan";
		/* TIM3: Ch2, 25kHz, Normal polarity */
		pwms = <&pwm3 1 40000 0>;
		interrupts-extended = <&gpiof 5 IRQ_TYPE_EDGE_FALLING>;
		interrupt-names = "fan0-tach";
		tach-gpios = <&gpiof 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
	};

	fan1: pwm-fan1 {
		compatible = "pwm-fan";
		/* TIM4: Ch2, 25kHz, Normal polarity */
		pwms = <&pwm4 1 40000 0>;
		interrupts-extended = <&gpiob 13 IRQ_TYPE_EDGE_FALLING>;
		interrupt-names = "fan1-tach";
		tach-gpios = <&gpiob 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
	};

	fan2: pwm-fan2 {
		compatible = "pwm-fan";
		/* TIM5: Ch2, 25kHz, Normal polarity */
		pwms = <&pwm5 1 40000 0>;
		interrupts-extended = <&gpiog 2 IRQ_TYPE_EDGE_FALLING>;
		interrupt-names = "fan2-tach";
		tach-gpios = <&gpiog 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
	};

	fan3: pwm-fan3 {
		compatible = "pwm-fan";
		/* TIM4: Ch3, 25kHz, Normal polarity */
		pwms = <&pwm4 2 40000 0>;
		interrupts-extended = <&gpiof 3 IRQ_TYPE_EDGE_FALLING>;
		interrupt-names = "fan3-tach";
		tach-gpios = <&gpiof 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
	};
};

&i2c5 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&i2c5_pins_a>;
	pinctrl-1 = <&i2c5_sleep_pins_a>;
	clock-frequency = <10000>;
	status = "okay";
};

&timers3 {
	status = "okay";
	pwm3: pwm {
		pinctrl-0 = <&pwm3_pins_a>;
		pinctrl-1 = <&pwm3_sleep_pins_a>;
		pinctrl-names = "default", "sleep";
		status = "okay";
	};
	timer@2 {
		status = "okay";
	};
};

&timers4 {
	status = "okay";
	pwm4: pwm {
		pinctrl-0 = <&pwm4_pins_a &pwm4_pins_b>;
		pinctrl-1 = <&pwm4_sleep_pins_a &pwm4_sleep_pins_b>;
		pinctrl-names = "default", "sleep";
		status = "okay";
	};
	timer@3 {
		status = "okay";
	};
};

&timers5 {
	status = "okay";
	pwm5: pwm {
		pinctrl-0 = <&pwm5_pins_a>;
		pinctrl-1 = <&pwm5_sleep_pins_a>;
		pinctrl-names = "default", "sleep";
		status = "okay";
	};
	timer@4 {
		status = "okay";
	};
};

&gpioa {
	gpio-line-names =
	"PA0",
	"PA1",
	"PA2",
	"PA3",
	"PA4",
	"PA5",
	"PA6",
	"PA7",
	"PSU_EN_N",
	"PA9",
	"PA10",
	"PA11",
	"PA12",
	"PA13",
	"PA14",
	"PA15";
};
