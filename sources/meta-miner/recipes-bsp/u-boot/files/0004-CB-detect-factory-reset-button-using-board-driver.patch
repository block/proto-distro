From 4731678487fc646e79dedfd10c5d1e5dd2455da2 Mon Sep 17 00:00:00 2001
From: BTCM SW Team <btcm-sw-team@squareup.com>
Date: Sun, 11 May 2025 10:36:47 +0800
Subject: [PATCH 04/17] CB detect factory reset button using board driver

%% original patch: 0001-CB-detect-factory-reset-button-using-board-driver.patch
---
 board/st/stm32mp1/stm32mp1.c | 72 ++++++++++++++++++++++++++++++++++++
 configs/stm32mp13_defconfig  |  2 +
 2 files changed, 74 insertions(+)

diff --git a/board/st/stm32mp1/stm32mp1.c b/board/st/stm32mp1/stm32mp1.c
index 05f41737e6d..da62f98ab0a 100644
--- a/board/st/stm32mp1/stm32mp1.c
+++ b/board/st/stm32mp1/stm32mp1.c
@@ -50,6 +50,7 @@
 #include <power/regulator.h>
 #include <tee/optee.h>
 #include <usb/dwc2_udc.h>
+#include <button.h>
 
 /* SYSCFG registers */
 #define SYSCFG_BOOTR		0x00
@@ -78,6 +79,9 @@
 #define GOODIX_REG_ID		0x8140
 #define GOODIX_ID_LEN		4
 
+#define POWER_BTN_FACTORY_RESET_DELAY_MS 5000
+#define POWER_BTN_POLL_INTERVAL_MS 1
+
 /*
  * Get a global data pointer
  */
@@ -88,6 +92,10 @@ DECLARE_GLOBAL_DATA_PTR;
 #define USB_START_LOW_THRESHOLD_UV	1230000
 #define USB_START_HIGH_THRESHOLD_UV	2150000
 
+#define PROTO_CB_DEFAULT_DEVNUM 1
+
+static int proto_cb_mmc_devnum = -1;
+
 int board_early_init_f(void)
 {
 	/* nothing to do, only used in SPL */
@@ -615,6 +623,61 @@ error:
 	return ret;
 }
 
+static void proto_cb_btn_check(void) {
+	struct udevice *rst_btn;
+	char *btn_name = "Power";
+
+	int ret = button_get_by_label("power-button", &rst_btn);
+	if (ret) {
+		// Power button is not used for this config, try if factory-reset button exist
+		ret = button_get_by_label("factory-reset-button", &rst_btn);
+		if (ret) {
+			// Neither button is available
+			return;
+		}
+		btn_name = "Factory Reset";
+	}
+
+	if (button_get_state(rst_btn)) {
+		log_info("%s button is held!\n", btn_name);
+		int power_btn_held_count_ms = 0;
+		while(button_get_state(rst_btn) && (power_btn_held_count_ms <= POWER_BTN_FACTORY_RESET_DELAY_MS)) {
+			mdelay(POWER_BTN_POLL_INTERVAL_MS);
+			power_btn_held_count_ms += POWER_BTN_POLL_INTERVAL_MS;
+		}
+		if (power_btn_held_count_ms > POWER_BTN_FACTORY_RESET_DELAY_MS) {
+			env_set("factory_reset", "y");
+			env_save();
+		} else {
+			log_info("%s button is released! Skipping factory reset.\n", btn_name);
+		}
+	}
+}
+
+static void proto_cb_board_init(void) {
+	int ret = env_select("MMC");
+	ret = !ret && env_load();
+	if (ret < 0) {
+		log_err("Failed to load env (%d)\n", ret);
+		log_info("Init Proto CB env variables.\n");
+	}
+}
+
+static void board_proto_cb_late_init(void)
+{
+}
+
+static bool board_is_proto_cb(void)
+{
+	if (CONFIG_IS_ENABLED(TARGET_ST_STM32MP13x) &&
+		(of_machine_is_compatible("st,stm32mp131f-c2p1") ||
+		of_machine_is_compatible("st,stm32mp131f-c2evt") ||
+		of_machine_is_compatible("st,stm32mp131f-c3p1")))
+		return true;
+
+	return false;
+}
+
 static bool board_is_stm32mp13x_dk(void)
 {
 	if (CONFIG_IS_ENABLED(TARGET_ST_STM32MP13x) &&
@@ -855,6 +918,11 @@ int board_init(void)
 	}
 
 	board_key_check();
+	if (board_is_proto_cb()) {
+		log_notice("Proto CB detected!\n");
+		proto_cb_board_init();
+		proto_cb_btn_check();
+  }
 
 	regulators_enable_boot_on(_DEBUG);
 
@@ -893,6 +961,10 @@ int board_late_init(void)
 	if (board_is_stm32mp15x_dk2())
 		board_stm32mp15x_dk2_init();
 
+	if (board_is_proto_cb()) {
+		board_proto_cb_late_init();
+	}
+
 	if (IS_ENABLED(CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG)) {
 		fdt_compat = fdt_getprop(gd->fdt_blob, 0, "compatible",
 					 &fdt_compat_len);
diff --git a/configs/stm32mp13_defconfig b/configs/stm32mp13_defconfig
index 75bcaff7eeb..4d62aaedf6a 100644
--- a/configs/stm32mp13_defconfig
+++ b/configs/stm32mp13_defconfig
@@ -142,3 +142,5 @@ CONFIG_FDT_FIXUP_PARTITIONS=y
 # CONFIG_LMB_USE_MAX_REGIONS is not set
 CONFIG_LMB_MEMORY_REGIONS=2
 CONFIG_LMB_RESERVED_REGIONS=16
+CONFIG_BUTTON=y
+CONFIG_BUTTON_GPIO=y
-- 
