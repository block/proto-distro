From f45ff3eb10bbe6b620c76a3cb601ca47ad857f3c Mon Sep 17 00:00:00 2001
From: BTCM SW Team <btcm-sw-team@squareup.com>
Date: Fri, 18 Apr 2025 10:27:58 -0400
Subject: [PATCH] Allow user ta access bsec_pta

---
 core/arch/arm/plat-stm32mp1/bsec_pta.c | 62 ++++++++++++++++----------
 1 file changed, 38 insertions(+), 24 deletions(-)

diff --git a/core/arch/arm/plat-stm32mp1/bsec_pta.c b/core/arch/arm/plat-stm32mp1/bsec_pta.c
index 262bca91c..2d1624e83 100644
--- a/core/arch/arm/plat-stm32mp1/bsec_pta.c
+++ b/core/arch/arm/plat-stm32mp1/bsec_pta.c
@@ -14,8 +14,15 @@
 #include <string.h>
 #include <util.h>
 
-#define TA_STM32MP_NVMEM_UUID { 0x1a8342cc, 0x81a5, 0x4512, \
-		{ 0x99, 0xfe, 0x9e, 0x2b, 0x3e, 0x37, 0xd6, 0x26 } }
+// The TAs in ALLOWED_ACCESS_TA_UUID are as follow (in order):
+// STM32MP NVMEM UID
+// Proto Provision TA
+// Proto unlocking TA
+#define ALLOWED_ACCESS_TA_UUID { \
+	{ 0x1a8342cc, 0x81a5, 0x4512, { 0x99, 0xfe, 0x9e, 0x2b, 0x3e, 0x37, 0xd6, 0x26 } }, \
+	{ 0x0d746117, 0x7c6a, 0x43e1, { 0x89, 0xa3, 0x59, 0x27, 0x23, 0x8b, 0x28, 0xfe } }, \
+	{ 0xa75709fa, 0xf0cc, 0x41c6, { 0x98, 0xec, 0xb3, 0x9b, 0x1f, 0x99, 0x31, 0x16 } }, \
+	}
 
 #define PTA_NAME "bsec.pta"
 
@@ -210,14 +217,14 @@ static TEE_Result bsec_write_mem(uint32_t pt, TEE_Param params[TEE_NUM_PARAMS])
 			}
 
 			if (*buf & LOCK_SHADOW_W) {
-				FMSG("Shadow write lock detected");
-				res = stm32_bsec_set_sw_lock(otp_id);
-				if (res)
-					break;
-			}
+					FMSG("Shadow write lock detected");
+					res = stm32_bsec_set_sw_lock(otp_id);
+					if (res)
+						break;
+				}
 
-			if (*buf & LOCK_SHADOW_P) {
-				FMSG("Shadow programming lock detected");
+				if (*buf & LOCK_SHADOW_P) {
+					FMSG("Shadow programming lock detected");
 				res = stm32_bsec_set_sp_lock(otp_id);
 			}
 
@@ -285,28 +292,35 @@ static TEE_Result pta_bsec_open_session(uint32_t ptypes __unused,
 {
 	uint32_t login = to_ta_session(ts_get_current_session())->clnt_id.login;
 	struct ts_session *caller_ts = ts_get_calling_session();
-	static const TEE_UUID ta_uuid = TA_STM32MP_NVMEM_UUID;
-	uint32_t state = BSEC_STATE_INVALID;
-	TEE_Result res = TEE_ERROR_GENERIC;
+	static const TEE_UUID allowed_ta_uuid[3] = ALLOWED_ACCESS_TA_UUID;
 
 	if (!IS_ENABLED(CFG_STM32_BSEC))
 		return TEE_ERROR_NOT_SUPPORTED;
 
-	if (login == TEE_LOGIN_TRUSTED_APP &&
-	    !memcmp((char *)&caller_ts->ctx->uuid, (char *)&ta_uuid,
-		    sizeof(TEE_UUID))) {
-		assert(is_user_ta_ctx(caller_ts->ctx));
-
-		res = stm32_bsec_get_state(&state);
-		if (res || state != BSEC_STATE_SEC_OPEN)
-			return TEE_ERROR_ACCESS_DENIED;
-
-		return TEE_SUCCESS;
-	}
-
 	if (login == TEE_LOGIN_REE_KERNEL)
 		return TEE_SUCCESS;
 
+	if (login == TEE_LOGIN_TRUSTED_APP) {
+		bool ta_allowed = false;
+		for (unsigned i = 0; i < sizeof(allowed_ta_uuid) / sizeof(allowed_ta_uuid[0]); i++) {
+			const TEE_UUID* ta_uuid = &allowed_ta_uuid[i];
+			FMSG("%s: TA UUID: %d, 0x%08x", __func__, i, caller_ts->ctx->uuid.timeLow);
+			ta_allowed = !memcmp((char *)&caller_ts->ctx->uuid, (char *)ta_uuid, sizeof(TEE_UUID));
+			if (ta_allowed) {
+				break;
+			}
+		}
+		if (ta_allowed) {
+			assert(is_user_ta_ctx(caller_ts->ctx));
+
+			return TEE_SUCCESS;
+		} else {
+			EMSG("Denied TA UUID");
+		}
+	} else {
+		EMSG("Not Trusted TA: %d", login);
+	}
+
 	return TEE_ERROR_ACCESS_DENIED;
 }
 
-- 
2.49.0

