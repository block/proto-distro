# Enable PMBUS support
CONFIG_PMBUS=y
CONFIG_SENSORS_PMBUS=y

# Enable SPI support (needed for WS2811)
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_SLAVE=y
CONFIG_SPI_STM32=y
CONFIG_SPI_SPIDEV=y

# Enable LED support
CONFIG_LEDS_TRIGGER_PATTERN=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y

# Basic I2C MUX framework
CONFIG_I2C_MUX=y

# GPIO support (might be needed)
CONFIG_GPIO_SYSFS=y

# I2C core
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_HELPER_AUTO=y

# Specifically for PCA954x
CONFIG_I2C_MUX_PCA954x=y

# Enable STM32 ADC and corresponding thermal module
CONFIG_GENERIC_ADC_THERMAL=y
CONFIG_STM32_ADC=y
CONFIG_STM32_ADC_CORE=y
