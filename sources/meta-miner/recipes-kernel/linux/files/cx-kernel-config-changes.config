# Enable PWM drivers
CONFIG_SENSORS_PWM_FAN=y
CONFIG_PWM=y
CONFIG_PWM_SYSFS=y
CONFIG_PWM_STM32=y
CONFIG_MFD_STM32_TIMERS=y

# Enable USB2514B Hub driver
CONFIG_USB_HUB_USB251XB=y

# Enable USB serial ports
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_XHCI_HCD=n
CONFIG_USB_XHCI_PLATFORM=n
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL_CP210X=y

# Enable polled GPIO inputs
CONFIG_KEYBOARD_GPIO_POLLED=y

# Disable CPU freq scaling
CONFIG_CPU_FREQ=n

# Coredump support
CONFIG_COREDUMP=y
CONFIG_CORE_DUMP_DEFAULT_ELF_HEADERS=y

# Use u-boot kernel args
CONFIG_CMDLINE=""

# Null TTY console for silencing serial output via console=ttynull
CONFIG_NULL_TTY=y
